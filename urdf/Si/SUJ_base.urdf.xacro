<?xml version="1.0"?>
<robot name="dvrk_si" xmlns:xacro="http://www.ros.org/wiki/xacro">

    <xacro:macro name="SUJ" params="prefix parent_link xyz rpy">
        <xacro:if value="${prefix == 'PSM1_' or prefix == 'PSM2_'}">
            <link
                name="SUJ_${prefix}L0">
                <visual>
                <origin
                    xyz="0.0 0.0 0.0"
                    rpy="0.0 0.0 0.0" />
                <geometry>
                    <mesh
                    filename="package://dvrk_model/meshes/SUJ/Si/PSM/PSM12/SUJ_PSM12_L0.stl" />
                </geometry>
                <material
                    name="">
                    <color
                    rgba="0.80000 0.80000 0.80000 1.0" />
                </material>
                </visual>
                <collision>
                <origin
                    xyz="0.0 0.0 0.0"
                    rpy="0.0 0.0 0.0" />
                <geometry>
                    <mesh
                    filename="package://dvrk_model/meshes/SUJ/Si/PSM/PSM12/SUJ_PSM12_L0.stl" />
                </geometry>
                </collision>
            </link>
            <joint
                name="SUJ_${prefix}J0"
                type="prismatic">
                <origin
                xyz="${xyz}"
                rpy="${rpy}" />
                <parent
                link="${parent_link}" />
                <child
                link="SUJ_${prefix}L0" />
                <axis
                xyz="0.0 0.0 1.0" />
