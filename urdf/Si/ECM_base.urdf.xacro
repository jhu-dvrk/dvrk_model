<?xml version="1.0" encoding="utf-8"?>
<robot name="dvrk_ecm_si" xmlns:xacro="http://www.ros.org/wiki/xacro">

  <xacro:include filename="$(find dvrk_model)/urdf/common.urdf.xacro"/>
  <xacro:include filename="$(find dvrk_model)/urdf/common/RCM_visual.urdf.xacro"/>

  <!--
    Si ECM arm — 4 actuated DOF:
      Joint 1: yaw       (revolute)
      Joint 2: pitch     (revolute, parallelogram linkage ×3)
      Joint 3: insertion (prismatic)
      Joint 4: roll      (revolute)

    Parallelogram mimic joints: pitch_2, pitch_3
    Macro output: ends at ${prefix}roll_link.
    Endoscope macro attaches here and adds only a fixed tip transform.
  -->

  <xacro:macro name="ecm_base"
               params="prefix parent_link
                       xyz:='0.0 0.0 0.0'
                       rpy:='0.0 0.0 0.0'">

    <!-- RCM reference frame (root of the arm when loaded directly) -->
    <link name="${prefix}RCM_link">
      <xacro:rcm_visual/>
    </link>

    <joint name="${prefix}rcm_fixed" type="fixed">
      <parent link="${parent_link}"/>
      <child  link="${prefix}RCM_link"/>
      <origin rpy="${rpy}" xyz="${xyz}"/>
    </joint>

    <!-- link 0: arm base -->
    <link name="${prefix}base_link">
      <inertial>
        <origin xyz="-0.080771 0.0 0.0" rpy="0.0 0.0 0.0"/>
        <mass value="1.5188"/>
        <inertia ixx="0.002395"  ixy="-2.6476E-18" ixz="-1.3484E-18"
                                  iyy="0.0040794"   iyz="4.2598E-10"
                                                     izz="0.0043778"/>
      </inertial>
      <visual>
        <origin xyz="0.0 0.0 0.0" rpy="0.0 0.0 0.0"/>
        <geometry>
          <mesh filename="package://dvrk_model/meshes/arms/Si/USM/USM_base.stl"/>
        </geometry>
        <material name=""><color rgba="0.80000 0.80000 0.80000 1"/></material>
      </visual>
      <collision>
        <origin xyz="0.0 0.0 0.0" rpy="0.0 0.0 0.0"/>
        <geometry>
          <mesh filename="package://dvrk_model/meshes/arms/Si/USM/USM_base.stl"/>
        </geometry>
      </collision>
    </link>

    <!-- fixed joint: RCM_link → base_link -->
    <joint name="${prefix}base_fixed" type="fixed">
      <parent link="${prefix}RCM_link"/>
      <child  link="${prefix}base_link"/>
      <origin xyz="0.0 -0.84316314 0.0" rpy="0.0 0.0 ${PI_2}"/>
    </joint>

    <!-- link 1: yaw body -->
    <link name="${prefix}yaw_link">
      <inertial>
        <origin xyz="0.1461 0.090363 -0.024957" rpy="0.0 0.0 0.0"/>
        <mass value="1.7571"/>
        <inertia ixx="0.0049404" ixy="-0.0035267" ixz="0.0045945"
                                  iyy="0.019686"   iyz="0.00070407"
                                                    izz="0.020795"/>
      </inertial>
      <visual>
        <origin xyz="0.0 0.0 0.0" rpy="0.0 0.0 0.0"/>
        <geometry>
          <mesh filename="package://dvrk_model/meshes/arms/Si/USM/USM_yaw.stl"/>
        </geometry>
        <material name=""><color rgba="0.80000 0.80000 0.80000 1"/></material>
      </visual>
      <collision>
        <origin xyz="0.0 0.0 0.0" rpy="0.0 0.0 0.0"/>
        <geometry>
          <mesh filename="package://dvrk_model/meshes/arms/Si/USM/USM_yaw.stl"/>
        </geometry>
      </collision>
    </link>

    <!-- joint 1: yaw -->
    <joint name="yaw" type="revolute">
      <origin xyz="0.158 0.0 0.0" rpy="0.0 0.0 0.0"/>
      <parent link="${prefix}base_link"/>
      <child  link="${prefix}yaw_link"/>
      <axis xyz="-1.0 0.0 0.0"/>
      <limit lower="-3.14" upper="3.14" effort="0.0" velocity="0.0"/>
    </joint>

    <!-- link 2: pitch arm -->
    <link name="${prefix}pitch_link">
      <inertial>
        <origin xyz="0.083895 -0.00073113 -0.028998" rpy="0.0 0.0 0.0"/>
        <mass value="4.017"/>
        <inertia ixx="0.012797"  ixy="-0.0002464"  ixz="0.0011164"
                                  iyy="0.026307"    iyz="8.5164E-05"
                                                     izz="0.025616"/>
      </inertial>
      <visual>
        <origin xyz="0.0 0.0 0.0" rpy="0.0 0.0 0.0"/>
        <geometry>
          <mesh filename="package://dvrk_model/meshes/arms/Si/USM/USM_pitch.stl"/>
        </geometry>
        <material name=""><color rgba="0.80000 0.80000 0.80000 1"/></material>
      </visual>
      <collision>
        <origin xyz="0.0 0.0 0.0" rpy="0.0 0.0 0.0"/>
        <geometry>
          <mesh filename="package://dvrk_model/meshes/arms/Si/USM/USM_pitch.stl"/>
        </geometry>
      </collision>
    </link>

    <!-- joint 2: pitch -->
    <joint name="pitch" type="revolute">
      <origin xyz="0.2987 0.0 -0.071222" rpy="0.0 -1.1345 -3.1416"/>
      <parent link="${prefix}yaw_link"/>
      <child  link="${prefix}pitch_link"/>
      <axis xyz="0.0 -1 0.0"/>
      <limit lower="-3.14" upper="3.14" effort="0" velocity="0"/>
    </joint>

    <!-- parallelogram sub-joint 2 (mimic pitch) -->
    <link name="${prefix}pitch_2_link">
      <inertial>
        <origin xyz="0.11824 0.0 0.12932" rpy="0.0 0.0 0.0"/>
        <mass value="2.1982"/>
        <inertia ixx="0.0076428"  ixy="-2.8207E-19" ixz="-0.0074855"
                                   iyy="0.032839"    iyz="-1.4256E-19"
                                                      izz="0.026585"/>
      </inertial>
      <visual>
        <origin xyz="0.0 0.0 0.0" rpy="0.0 0.0 0.0"/>
        <geometry>
          <mesh filename="package://dvrk_model/meshes/arms/Si/USM/USM_pitch_3.stl"/>
        </geometry>
        <material name=""><color rgba="0.80000 0.80000 0.80000 1"/></material>
      </visual>
      <collision>
        <origin xyz="0.0 0.0 0.0" rpy="0.0 0.0 0.0"/>
        <geometry>
          <mesh filename="package://dvrk_model/meshes/arms/Si/USM/USM_pitch_3.stl"/>
        </geometry>
      </collision>
    </link>
    <joint name="pitch_2" type="revolute">
      <origin xyz="0.2032 0.0 0.0" rpy="0.0 -0.90761 -3.1416"/>
      <parent link="${prefix}pitch_link"/>
      <child  link="${prefix}pitch_2_link"/>
      <axis xyz="0.0 1 0.0"/>
      <limit lower="-3.14" upper="3.14" effort="0" velocity="0"/>
      <mimic joint="pitch" multiplier="-1"/>
    </joint>

    <!-- parallelogram sub-joint 3 (mimic pitch) -->
    <link name="${prefix}pitch_3_link">
      <inertial>
        <origin xyz="0.041219 0.0 0.13651" rpy="0.0 0.0 0.0"/>
        <mass value="0.75206"/>
        <inertia ixx="0.018546"   ixy="3.3933E-09"  ixz="0.00048607"
                                   iyy="0.018573"    iyz="-1.7077E-08"
                                                      izz="0.00039277"/>
      </inertial>
      <visual>
        <origin xyz="0.0 0.0 0.0" rpy="0.0 0.0 0.0"/>
        <geometry>
          <mesh filename="package://dvrk_model/meshes/arms/Si/USM/USM_pitch_4.stl"/>
        </geometry>
        <material name=""><color rgba="0.80000 0.80000 0.80000 1"/></material>
      </visual>
      <collision>
        <origin xyz="0.0 0.0 0.0" rpy="0.0 0.0 0.0"/>
        <geometry>
          <mesh filename="package://dvrk_model/meshes/arms/Si/USM/USM_pitch_4.stl"/>
        </geometry>
      </collision>
    </link>
    <joint name="pitch_3" type="revolute">
      <origin xyz="0.35966 0.0 0.16013" rpy="0.0 -0.063963 0.0"/>
      <parent link="${prefix}pitch_2_link"/>
      <child  link="${prefix}pitch_3_link"/>
      <axis xyz="0.0 1 0.0"/>
      <limit lower="-3.14" upper="3.14" effort="0" velocity="0"/>
      <mimic joint="pitch" multiplier="1"/>
    </joint>

    <!-- joint 3: insertion -->
    <joint name="insertion" type="prismatic">
      <origin xyz="0.05061 0.0 0.41911" rpy="${PI} 0.0 0.0"/>
      <parent link="${prefix}pitch_3_link"/>
      <child  link="${prefix}insertion_link"/>
      <axis xyz="0.0 0.0 1"/>
      <limit lower="0.0" upper="0.299" velocity="0.4" effort="1000"/>
    </joint>

    <!-- link 3: insertion — boundary before roll -->
    <link name="${prefix}insertion_link"/>

    <!-- joint 4: roll -->
    <!-- origin z=0.2093 places roll_link exactly 0.3829 m above RCM (was 0.1252 m at z=0.4670) -->
    <joint name="roll" type="revolute">
      <origin xyz="0.06462752 0.0 0.2093" rpy="0.0 0.0 0.0"/>
      <parent link="${prefix}insertion_link"/>
      <child  link="${prefix}roll_link"/>
      <axis xyz="0.0 0.0 1"/>
      <limit lower="-4.53786" upper="4.53786" velocity=".4" effort="1000"/>
    </joint>

    <!--
      link 4: roll — last link of ECM base.
      Mesh-free: the endoscope macro owns all visuals to allow endoscope swapping.
    -->
    <link name="${prefix}roll_link"/>

    <joint name="${prefix}adaptor_fixed" type="fixed">
      <parent link="${prefix}roll_link"/>
      <child  link="${prefix}adaptor_link"/>
      <origin xyz="0.0 0.0 0.0" rpy="0.0 0.0 0.0"/>
    </joint>
    <link name="${prefix}adaptor_link"/>

  </xacro:macro>

</robot>
