<?xml version="1.0" ?>
<robot name="patient_cart" xmlns:xacro="http://www.ros.org/wiki/xacro">

  <xacro:include filename="$(find dvrk_model)/urdf/common.urdf.xacro"/>
  <xacro:include filename="$(find dvrk_model)/urdf/Si/SUJ_base.urdf.xacro"/>
  <xacro:include filename="$(find dvrk_model)/urdf/Si/SUJ_cart.urdf.xacro"/>

  <xacro:SUJ_cart/>
  <xacro:SUJ
      prefix="PSM1_"
      parent_link="SUJ_cart"
      xyz="0.0 0.228 0.528"
      rpy="0.0 0.0 ${PI / 2.0}"/>

  <xacro:SUJ
      prefix="PSM2_"
      parent_link="SUJ_cart"
      xyz="0.0 -0.228 0.528"
      rpy="0.0 0.0 ${-PI / 2.0}" />

  <xacro:SUJ
      prefix="PSM3_"
      parent_link="SUJ_cart"
      xyz="-0.223 0.0 0.528"
      rpy="0.0 0.0 ${-PI}"/>

  <xacro:SUJ
      prefix="ECM_"
      parent_link="SUJ_cart"
      xyz="0.223 0.0 0.528"
      rpy="0.0 0.0 0.0"/>

</robot>
