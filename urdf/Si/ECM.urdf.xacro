<?xml version="1.0" ?>
<robot name="ECM" xmlns:xacro="http://www.ros.org/wiki/xacro">
  <xacro:arg name="parent_link_" default="world"/>
  <xacro:property name="parent_link" default="$(arg parent_link_)"/>

  <xacro:include filename="$(find dvrk_model)/urdf/Si/PSM_base_macros.urdf.xacro"/>
  <xacro:include filename="$(find dvrk_model)/urdf/common/PSM_instrument_macros.urdf.xacro"/>

  <link name="${parent_link}"/>

  <xacro:base prefix="ECM_"
                  parent_link="${parent_link}"/>

  <xacro:PSM_instrument prefix="ECM_"
                        parent_link="ECM_tool_parent_link"
                        instrument="SF0826001"/>
</robot>
