<?xml version="1.0" ?>
<robot name="dvrk_psm" xmlns:xacro="http://www.ros.org/wiki/xacro">

  <xacro:arg name="prefix" default="PSM1_"/>

  <!-- Macros -->
  <xacro:include filename="$(find dvrk_model)/urdf/Classic/archive/psm.urdf.xacro"/>

  <link name="world"/>
  <xacro:psm_snake
      prefix="$(arg prefix)"
      parent_link="world"
      xyz="-0.25 0.0 0.5" rpy="0.0 0.0 ${PI}"/>

</robot>
