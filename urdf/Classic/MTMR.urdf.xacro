<?xml version="1.0" ?>
<robot name="MTMR" xmlns:xacro="http://www.ros.org/wiki/xacro">

  <!-- Macros -->
  <xacro:include filename="$(find dvrk_model)/urdf/Classic/MTM.urdf.xacro"/>

  <link name="world"/>
  <xacro:mtm_right
      prefix="MTMR_"
      parent_link="world"
      xyz="0.25 0.0 1.0"/>

</robot>
