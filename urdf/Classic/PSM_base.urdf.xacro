<?xml version="1.0" encoding="utf-8"?>
<robot name="dvrk_psm" xmlns:xacro="http://www.ros.org/wiki/xacro">

  <xacro:include filename="$(find dvrk_model)/urdf/common.urdf.xacro"/>
  <xacro:include filename="$(find dvrk_model)/urdf/common/RCM_visual.urdf.xacro"/>

  <!--
    Classic PSM arm — 3 actuated DOF:
      Joint 1: yaw   (revolute)
      Joint 2: pitch  (revolute, parallelogram linkage)
      Joint 3: insertion    (prismatic)

    Macro output: ends at ${prefix}adaptor_link.
    The instrument macro (instrument) attaches here and owns roll onward.

    Parameters:
      prefix      — arm instance prefix, e.g. "PSM1_"
      parent_link — link to attach the base to (typically "world")
      xyz / rpy   — placement of the arm base relative to parent_link
  -->

  <xacro:macro name="base"
               params="prefix parent_link
                       xyz:='0.0 0.0 0.0'
                       rpy:='0.0 0.0 0.0'">

    <!-- RCM reference frame (root of the arm when loaded directly) -->
    <link name="${prefix}RCM_link">
      <xacro:rcm_visual/>
    </link>

    <joint name="${prefix}rcm_fixed" type="fixed">
      <parent link="${parent_link}"/>
      <child  link="${prefix}RCM_link"/>
      <origin rpy="0.0 0.0 0.0" xyz="0.0 0.0 0.0"/>
    </joint>

    <!-- fixed joint: RCM_link → base_link -->
    <joint name="${prefix}base_fixed" type="fixed">
      <parent link="${prefix}RCM_link"/>
      <child  link="${prefix}base_link"/>
      <origin rpy="${rpy}" xyz="${xyz}"/>
    </joint>

    <!-- link 0: base -->
    <link name="${prefix}base_link">
      <visual>
        <origin rpy="1.5708 0.0 3.1416" xyz="0.039 -0.40788 -0.07879"/>
        <geometry>
          <mesh filename="package://dvrk_model/meshes/arms/Classic/PSM/PSM_base.dae"/>
        </geometry>
      </visual>
    </link>

    <!-- joint 1: yaw -->
    <joint name="yaw" type="revolute">
      <parent link="${prefix}base_link"/>
      <child  link="${prefix}yaw_link"/>
      <axis xyz="0.0 0.0 1"/>
      <origin rpy="0.0 -1.5708 1.5708" xyz="0.0 0.0 0.0"/>
      <limit lower="-1.5707" upper="1.5707" velocity=".4" effort="1000"/>
    </joint>

    <!-- link 1: yaw -->
    <link name="${prefix}yaw_link">
      <visual>
        <origin rpy="3.1416 0.0 1.5708" xyz="0.0125 0.0 0.5265"/>
        <geometry>
          <mesh filename="package://dvrk_model/meshes/arms/Classic/PSM/PSM_yaw.dae"/>
        </geometry>
      </visual>
    </link>

    <!--
      Joint 2: pitch (revolute) with parallelogram linkage.
      The pitch_link itself has no mesh; the visual is distributed
      across the 4 parallelogram sub-links below.
    -->
    <joint name="pitch" type="revolute">
      <parent link="${prefix}yaw_link"/>
      <child  link="${prefix}pitch_link"/>
      <axis xyz="0.0 0.0 1"/>
      <origin rpy="-1.5708 -1.5708 0.0" xyz="0.0 0.0 0.0"/>
      <limit lower="-0.7854" upper="0.7854" velocity=".4" effort="1000"/>
    </joint>

    <link name="${prefix}pitch_link"/>

    <!-- parallelogram sub-joint 2: back -->
    <joint name="pitch_2" type="continuous">
      <parent link="${prefix}yaw_link"/>
      <child  link="${prefix}pitch_2_link"/>
      <axis xyz="0.0 0.0 1"/>
      <origin rpy="-1.5708 -1.5708 0.0" xyz="0.0 0.0295 0.5185"/>
      <mimic joint="pitch" multiplier="1"/>
    </joint>

    <link name="${prefix}pitch_2_link">
      <visual>
        <origin rpy="0.0 0.0 -0.27129" xyz="0.0 0.0 0.0"/>
        <geometry>
          <mesh filename="package://dvrk_model/meshes/arms/Classic/PSM/PSM_pitch_2.dae"/>
        </geometry>
      </visual>
    </link>

    <!-- parallelogram sub-joint 3: front -->
    <joint name="pitch_3" type="continuous">
      <parent link="${prefix}yaw_link"/>
      <child  link="${prefix}pitch_3_link"/>
      <axis xyz="0.0 0.0 1"/>
      <origin rpy="-1.5708 -1.5708 0.0" xyz="0.0 0.0295 0.4285"/>
      <mimic joint="pitch" multiplier="1"/>
    </joint>

    <link name="${prefix}pitch_3_link">
      <visual>
        <origin rpy="0.0 0.0 -0.27129" xyz="0.0 0.0 0.0"/>
        <geometry>
          <mesh filename="package://dvrk_model/meshes/arms/Classic/PSM/PSM_pitch_3.dae"/>
        </geometry>
      </visual>
    </link>

    <!-- parallelogram sub-joint 4: bottom -->
    <joint name="pitch_4" type="continuous">
      <parent link="${prefix}pitch_2_link"/>
      <child  link="${prefix}pitch_4_link"/>
      <axis xyz="0.0 0.0 1"/>
      <origin rpy="0.0 0.0 0.0" xyz="0.04178 0.15007 -0.0137"/>
      <mimic joint="pitch" multiplier="-1"/>
    </joint>

    <link name="${prefix}pitch_4_link">
      <visual>
        <origin rpy="0.0 -1.5708 0.0" xyz="0.009 0.0 0.0"/>
        <geometry>
          <mesh filename="package://dvrk_model/meshes/arms/Classic/PSM/PSM_pitch_4.dae"/>
        </geometry>
      </visual>
    </link>

    <!-- parallelogram sub-joint 5: top -->
    <joint name="pitch_5" type="continuous">
      <parent link="${prefix}pitch_2_link"/>
      <child  link="${prefix}pitch_5_link"/>
      <axis xyz="0.0 0.0 1"/>
      <origin rpy="0.0 0.0 0.0" xyz="0.04209 0.18695 -0.02412"/>
      <mimic joint="pitch" multiplier="-1"/>
    </joint>

    <link name="${prefix}pitch_5_link">
      <visual>
        <origin rpy="0.0 -1.5708 0.0" xyz="0.009 0.0 0.0"/>
        <geometry>
          <mesh filename="package://dvrk_model/meshes/arms/Classic/PSM/PSM_pitch_5.dae"/>
        </geometry>
      </visual>
    </link>

    <!-- parallelogram sub-joint 6: insertion carrier -->
    <joint name="pitch_6" type="continuous">
      <parent link="${prefix}pitch_4_link"/>
      <child  link="${prefix}insertion_link"/>
      <axis xyz="0.0 0.0 1"/>
      <origin rpy="0.0 0.0 0.0" xyz="-0.520 0.0 -0.0155"/>
      <mimic joint="pitch" multiplier="1"/>
    </joint>

    <link name="${prefix}insertion_link">
      <visual>
        <origin rpy="0.0 -1.5708 1.5708" xyz="0.02528 0.429 0.0"/>
        <geometry>
          <mesh filename="package://dvrk_model/meshes/arms/Classic/PSM/PSM_insertion.dae"/>
        </geometry>
      </visual>
    </link>

    <!-- joint 3: insertion (prismatic) -->
    <joint name="insertion" type="prismatic">
      <parent link="${prefix}pitch_link"/>
      <child  link="${prefix}adaptor_link"/>
      <axis xyz="0.0 0.0 1"/>
      <origin rpy="${PI_2} 0.0 0.0" xyz="0.0 0.4318 0.0"/>
      <limit lower="0" upper="0.240" velocity=".4" effort="1000"/>
    </joint>

    <!--
      link 3: adaptor_link
      Massless boundary link — handoff point to instrument.
      This is the instrument_base frame from the kinematic JSON: aligned
      with the insertion/roll axis and offset 0.4318 m from the RCM.
    -->
    <link name="${prefix}adaptor_link"/>

  </xacro:macro>

</robot>
