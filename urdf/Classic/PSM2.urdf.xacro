<?xml version="1.0" ?>
<robot name="PSM2" xmlns:xacro="http://www.ros.org/wiki/xacro">
  <xacro:arg name="instrument" default="400049"/>
  <xacro:arg name="parent_link_" default="world"/>
  <xacro:property name="parent_link" default="$(arg parent_link_)"/>

  <xacro:include filename="$(find dvrk_model)/urdf/Classic/PSM_base_macros.urdf.xacro"/>
  <xacro:include filename="$(find dvrk_model)/urdf/common/PSM_instrument_macros.urdf.xacro"/>

  <link name="${parent_link}"/>

  <xacro:base prefix="PSM2_"
                  parent_link="${parent_link}"
                  xyz="-0.25 0.0 0.5" rpy="0.0 0.0 ${PI}"/>

  <xacro:PSM_instrument prefix="PSM2_"
                        parent_link="PSM2_tool_parent_link"
                        instrument="$(arg instrument)"/>

</robot>
