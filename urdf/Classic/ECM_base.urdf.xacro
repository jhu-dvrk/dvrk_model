<?xml version="1.0" ?>
<robot name="ECM" xmlns:xacro="http://www.ros.org/wiki/xacro">
  <!-- Colors and RCM visualizer -->
  <xacro:include filename="$(find dvrk_model)/urdf/common.urdf.xacro"/>
  <xacro:include filename="$(find dvrk_model)/urdf/common/RCM_visual.urdf.xacro"/>

  <!--
    Classic ECM arm — 4 actuated DOF:
      Joint 1: yaw       (revolute)
      Joint 2: pitch     (revolute, parallelogram linkage)
      Joint 3: insertion (prismatic)
      Joint 4: roll      (revolute)

    Parallelogram mimic joints: pitch_2 … pitch_5
    Macro output: ends at ${prefix}roll_link.
    Endoscope macro attaches here and adds only a fixed tip transform.
  -->
  <xacro:macro name="ecm_base" params="prefix parent_link xyz:='0.0 0.0 0.0' rpy:='0.0 0.0 0.0'">

    <!-- RCM reference frame (root of the arm when loaded directly) -->
    <link name="${prefix}RCM_link">
      <xacro:rcm_visual/>
    </link>

    <joint name="${prefix}rcm_fixed" type="fixed">
      <parent link="${parent_link}"/>
      <child  link="${prefix}RCM_link"/>
      <origin rpy="${rpy}" xyz="${xyz}"/>
    </joint>

    <joint name="${prefix}base_fixed" type="fixed">
      <parent link="${prefix}RCM_link"/>
      <child  link="${prefix}base_link"/>
      <origin xyz="-0.612599207482277 0.0 -0.101460" rpy="0.0 0.0 0.0"/>
    </joint>

    <!-- link 0: base -->
    <link name="${prefix}base_link">
      <visual>
        <origin xyz="0.0 0.0 0.0" rpy="0.0 0.0 0.0"/>
        <geometry>
          <mesh filename="package://dvrk_model/meshes/arms/Classic/ECM/ECM_base.stl"/>
        </geometry>
        <material name="DaVinciLightGray"><color rgba="0.64706 0.61961 0.58824 1"/></material>
      </visual>
      <collision>
        <origin xyz="0.0 0.0 0.0" rpy="0.0 0.0 0.0"/>
        <geometry>
          <mesh filename="package://dvrk_model/meshes/arms/Classic/ECM/ECM_base.stl"/>
        </geometry>
      </collision>
    </link>

    <!-- link 1: yaw -->
    <link name="${prefix}yaw_link">
      <visual>
        <origin xyz="0.0 0.0 0.0" rpy="0.0 0.0 0.0"/>
        <geometry>
          <mesh filename="package://dvrk_model/meshes/arms/Classic/ECM/ECM_yaw.stl"/>
        </geometry>
        <material name="DaVinciLightGray"><color rgba="0.64706 0.61961 0.58824 1"/></material>
      </visual>
      <collision>
        <origin xyz="0.0 0.0 0.0" rpy="0.0 0.0 0.0"/>
        <geometry>
          <mesh filename="package://dvrk_model/meshes/arms/Classic/ECM/ECM_yaw.stl"/>
        </geometry>
      </collision>
    </link>

    <!-- joint 1: yaw -->
    <joint name="yaw" type="revolute">
      <origin xyz="0.0731999999999783 0.0 0.101460000000185" rpy="${PI_2} 0.0 ${PI_2}"/>
      <parent link="${prefix}base_link"/>
      <child  link="${prefix}yaw_link"/>
      <axis xyz="0.0 0.0 1"/>
      <limit lower="-1.595183" upper="1.581733" effort="1000" velocity="10"/>
    </joint>

    <!-- link 2: pitch (primary arm, carries the pitch visual) -->
    <link name="${prefix}pitch_link">
      <visual>
        <origin xyz="0.0 0.0 0.0" rpy="0.0 0.0 0.0"/>
        <geometry>
          <mesh filename="package://dvrk_model/meshes/arms/Classic/ECM/ECM_pitch.stl"/>
        </geometry>
        <material name="DaVinciLightGray"><color rgba="0.64706 0.61961 0.58824 1"/></material>
      </visual>
      <collision>
        <origin xyz="0.0 0.0 0.0" rpy="0.0 0.0 0.0"/>
        <geometry>
          <mesh filename="package://dvrk_model/meshes/arms/Classic/ECM/ECM_pitch.stl"/>
        </geometry>
      </collision>
    </link>

    <!-- joint 2: pitch -->
    <joint name="pitch" type="revolute">
      <origin xyz="0.0 0.0 0.199000000000014" rpy="${PI} -${PI_2} 0.0"/>
      <parent link="${prefix}yaw_link"/>
      <child  link="${prefix}pitch_link"/>
      <axis xyz="0.0 0.0 1"/>
      <limit lower="-0.783710" upper="1.157657" effort="1000" velocity="10"/>
    </joint>

    <!-- parallelogram sub-joint 2: bottom -->
    <link name="${prefix}pitch_2_link">
      <visual>
        <origin xyz="0.0 0.0 0.0" rpy="0.0 0.0 0.0"/>
        <geometry>
          <mesh filename="package://dvrk_model/meshes/arms/Classic/ECM/ECM_pitch_2.stl"/>
        </geometry>
        <material name="DaVinciDarkGray"><color rgba="0.25098 0.25098 0.25098 1"/></material>
      </visual>
      <collision>
        <origin xyz="0.0 0.0 0.0" rpy="0.0 0.0 0.0"/>
        <geometry>
          <mesh filename="package://dvrk_model/meshes/arms/Classic/ECM/ECM_pitch_2.stl"/>
        </geometry>
      </collision>
    </link>
    <joint name="pitch_2" type="revolute">
      <origin xyz="-0.103000865501078 -0.286804989831434 0.0" rpy="0.0 0.0 0.0"/>
      <parent link="${prefix}pitch_link"/>
      <child  link="${prefix}pitch_2_link"/>
      <axis xyz="0.0 0.0 1"/>
      <limit lower="-1.157657" upper="0.783710" effort="1000" velocity="10"/>
      <mimic joint="pitch" multiplier="-1"/>
    </joint>

    <!-- parallelogram sub-joint 3: end (carries insertion) -->
    <link name="${prefix}pitch_3_link">
      <visual>
        <origin xyz="0.0 0.0 0.0" rpy="0.0 0.0 0.0"/>
        <geometry>
          <mesh filename="package://dvrk_model/meshes/arms/Classic/ECM/ECM_pitch_3.stl"/>
        </geometry>
        <material name="DaVinciWhite"><color rgba="0.89804 0.91765 0.92941 1"/></material>
      </visual>
      <collision>
        <origin xyz="0.0 0.0 0.0" rpy="0.0 0.0 0.0"/>
        <geometry>
          <mesh filename="package://dvrk_model/meshes/arms/Classic/ECM/ECM_pitch_3.stl"/>
        </geometry>
      </collision>
    </link>
    <joint name="pitch_3" type="revolute">
      <origin xyz="0.340400072983362 -0.000135620545844151 0.0" rpy="0.0 0.0 0.0"/>
      <parent link="${prefix}pitch_2_link"/>
      <child  link="${prefix}pitch_3_link"/>
      <axis xyz="0.0 0.0 1"/>
      <limit lower="-0.783710" upper="1.157657" effort="1000" velocity="10"/>
      <mimic joint="pitch" multiplier="1"/>
    </joint>

    <!-- parallelogram sub-joint 4: top -->
    <link name="${prefix}pitch_4_link">
      <visual>
        <origin xyz="0.0 0.0 0.0" rpy="0.0 0.0 0.0"/>
        <geometry>
          <mesh filename="package://dvrk_model/meshes/arms/Classic/ECM/ECM_pitch_4.stl"/>
        </geometry>
        <material name="DaVinciRed"><color rgba="0.64706 0.51765 0 1"/></material>
      </visual>
      <collision>
        <origin xyz="0.0 0.0 0.0" rpy="0.0 0.0 0.0"/>
        <geometry>
          <mesh filename="package://dvrk_model/meshes/arms/Classic/ECM/ECM_pitch_4.stl"/>
        </geometry>
      </collision>
    </link>
    <joint name="pitch_4" type="revolute">
      <origin xyz="-0.10847228839493 -0.324257434492051 0.0" rpy="0.0 0.0 0.0"/>
      <parent link="${prefix}pitch_link"/>
      <child  link="${prefix}pitch_4_link"/>
      <axis xyz="0.0 0.0 1"/>
      <limit lower="-1.157657" upper="0.783710" effort="1000" velocity="10"/>
      <mimic joint="pitch" multiplier="-1"/>
    </joint>

    <!-- parallelogram sub-joint 5: back -->
    <link name="${prefix}pitch_5_link">
      <visual>
        <origin xyz="0.0 0.0 0.0" rpy="0.0 0.0 0.0"/>
        <geometry>
          <mesh filename="package://dvrk_model/meshes/arms/Classic/ECM/ECM_pitch_5.stl"/>
        </geometry>
        <material name="DaVinciRed"><color rgba="0.64706 0.51765 0 1"/></material>
      </visual>
      <collision>
        <origin xyz="0.0 0.0 0.0" rpy="0.0 0.0 0.0"/>
        <geometry>
          <mesh filename="package://dvrk_model/meshes/arms/Classic/ECM/ECM_pitch_5.stl"/>
        </geometry>
      </collision>
    </link>
    <joint name="pitch_5" type="revolute">
      <origin xyz="0.0 -0.00979999999999302 0.162430000000002" rpy="${PI} -${PI_2} 0.0"/>
      <parent link="${prefix}yaw_link"/>
      <child  link="${prefix}pitch_5_link"/>
      <axis xyz="0.0 0.0 1"/>
      <limit lower="-0.783710" upper="1.157657" effort="1000" velocity="10"/>
      <mimic joint="pitch" multiplier="1"/>
    </joint>

    <!-- link 3: insertion (carries the main insertion tube visual) -->
    <link name="${prefix}insertion_link">
      <visual>
        <origin xyz="0.0 0.0 0.0" rpy="0.0 0.0 0.0"/>
        <geometry>
          <mesh filename="package://dvrk_model/meshes/arms/Classic/ECM/ECM_main_insertion.stl"/>
        </geometry>
        <material name="DaVinciDarkGray"><color rgba="0.25 0.25 0.25 1"/></material>
      </visual>
      <collision>
        <origin xyz="0.0 0.0 0.0" rpy="0.0 0.0 0.0"/>
        <geometry>
          <mesh filename="package://dvrk_model/meshes/arms/Classic/ECM/ECM_main_insertion.stl"/>
        </geometry>
      </collision>
    </link>

    <!-- joint 3: insertion -->
    <joint name="insertion" type="prismatic">
      <origin xyz="0.042 -0.086143 0.0" rpy="-${PI_2} 0.0 0.0"/>
      <parent link="${prefix}pitch_3_link"/>
      <child  link="${prefix}insertion_link"/>
      <axis xyz="0.0 0.0 1"/>
      <limit lower="0" upper="0.254193" effort="50" velocity="100"/>
    </joint>

    <!-- link 4: roll — last link of ECM base; endoscope attaches here -->
    <!-- Meshes are owned by the endoscope macro to allow swapping endoscopes. -->
    <link name="${prefix}roll_link"/>

    <!-- joint 4: roll -->
    <!-- origin z=-0.010 shifts roll_link to exactly 0.3829 m above RCM (was 0.3729 m) -->
    <joint name="roll" type="revolute">
      <origin xyz="0.0609999999999996 0.0 -0.010" rpy="0.0 0.0 0.0"/>
      <parent link="${prefix}insertion_link"/>
      <child  link="${prefix}roll_link"/>
      <axis xyz="0.0 0.0 -1"/>
      <limit lower="-1.552676" upper="1.566741" effort="1000" velocity="10"/>
    </joint>

    <joint name="${prefix}adaptor_fixed" type="fixed">
      <parent link="${prefix}roll_link"/>
      <child  link="${prefix}adaptor_link"/>
      <origin xyz="0.0 0.0 0.0" rpy="0.0 0.0 0.0"/>
    </joint>
    <link name="${prefix}adaptor_link"/>

    <!-- Alias link for backward compatibility with older rviz configs referencing remote_center_link -->
    <link name="${prefix}remote_center_link"/>
    <joint name="${prefix}remote_center_alias" type="fixed">
      <parent link="${prefix}RCM_link"/>
      <child  link="${prefix}remote_center_link"/>
      <origin xyz="0.0 0.0 0.0" rpy="0.0 0.0 0.0"/>
    </joint>

  </xacro:macro>

</robot>
