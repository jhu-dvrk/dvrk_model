      <xacro:instrument_model prefix="${prefix}"
                              housing="Classic"
                              roll="4162"
                              wrist_pitch="0107"
                              wrist_yaw="0107"
                              tip="093"/>
    </xacro:if>

    <!-- 400127: Classic 127 -->
    <xacro:if value="${str(instrument) == '400127'}">
      <xacro:instrument_model prefix="${prefix}"
                              housing="Classic"
                              roll="4162"
                              wrist_pitch="0107"
                              wrist_yaw="0107"
                              tip="127"/>
    </xacro:if>

    <!-- 400172: Classic 172 -->
    <xacro:if value="${str(instrument) == '400172'}">
      <xacro:instrument_model prefix="${prefix}"
                              housing="Classic"
                              roll="4162"
                              wrist_pitch="0107"
                              wrist_yaw="0107"
                              tip="172"/>
    </xacro:if>

    <!-- 400178: Classic 178 -->
    <xacro:if value="${str(instrument) == '400178'}">
      <xacro:instrument_model prefix="${prefix}"
                              housing="Classic"
                              roll="4162"
                              wrist_pitch="0091"
                              wrist_yaw="0091"
                              tip="178"/>
    </xacro:if>

    <!-- 400179: Classic 179 -->
    <xacro:if value="${str(instrument) == '400179'}">
      <xacro:instrument_model prefix="${prefix}"
                              housing="Classic"
                              roll="4162"
                              wrist_pitch="0091"
                              wrist_yaw="0091"
                              tip="179"/>
    </xacro:if>

    <!-- 400181: Classic 181 -->
    <xacro:if value="${str(instrument) == '400181'}">
      <xacro:instrument_model prefix="${prefix}"
                              housing="Classic"
                              roll="4162"
                              wrist_pitch="0091"
                              wrist_yaw="0091"
                              tip="181"/>
    </xacro:if>

    <!-- 400189: Classic 189 -->
    <xacro:if value="${str(instrument) == '400189'}">
