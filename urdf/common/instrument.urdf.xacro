                              housing="Si"
                              roll="4670"
                              wrist_pitch="0091"
                              wrist_yaw="0091"
                              tip="178"/>
    </xacro:if>

    <!-- 420179: Si 179 -->
    <xacro:if value="${str(instrument) == '420179'}">
      <xacro:instrument_model prefix="${prefix}"
                              housing="Si"
                              roll="4670"
                              wrist_pitch="0091"
                              wrist_yaw="0091"
                              tip="179"/>
    </xacro:if>

    <!-- 420181: Si 181 -->
    <xacro:if value="${str(instrument) == '420181'}">
      <xacro:instrument_model prefix="${prefix}"
                              housing="Si"
                              roll="4670"
                              wrist_pitch="0091"
                              wrist_yaw="0091"
                              tip="181"/>
    </xacro:if>

    <!-- 420205: Si 205 -->
    <xacro:if value="${str(instrument) == '420205'}">
      <xacro:instrument_model prefix="${prefix}"
                              housing="Si"
                              roll="4670"
                              wrist_pitch="0107"
                              wrist_yaw="0107"
                              tip="205"/>
    </xacro:if>

    <!-- 420230: Si 230 -->
    <xacro:if value="${str(instrument) == '420230'}">
      <xacro:instrument_model prefix="${prefix}"
                              housing="Si"
                              roll="4670"
                              wrist_pitch="0107"
                              wrist_yaw="0107"
                              tip="230"/>
    </xacro:if>

    <!-- 420296: Si 296 -->
    <xacro:if value="${str(instrument) == '420296'}">
      <xacro:instrument_model prefix="${prefix}"
                              housing="Si"
                              roll="4670"
                              wrist_pitch="0091"
                              wrist_yaw="0091"
                              tip="296"/>
    </xacro:if>

    <!-- 420327: Si 327 -->
    <xacro:if value="${str(instrument) == '420327'}">
      <xacro:instrument_model prefix="${prefix}"
                              housing="Si"
                              roll="4670"
                              wrist_pitch="0107"
