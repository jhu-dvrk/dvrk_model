    <!-- 420036: Si 036 -->
    <xacro:if value="${str(instrument) == '420036'}">
      <xacro:instrument_model prefix="${prefix}"
                              housing="Si"
                              roll="4670"
                              wrist_pitch="0091"
                              wrist_yaw="0091"
                              tip="036"/>
    </xacro:if>

    <!-- 420048: Si 048 -->
    <xacro:if value="${str(instrument) == '420048'}">
      <xacro:instrument_model prefix="${prefix}"
                              housing="Si"
                              roll="4670"
                              wrist_pitch="0091"
                              wrist_yaw="0091"
                              tip="048"/>
    </xacro:if>

    <!-- 420049: Si 049 -->
    <xacro:if value="${str(instrument) == '420049'}">
      <xacro:instrument_model prefix="${prefix}"
                              housing="Si"
                              roll="4670"
                              wrist_pitch="0091"
                              wrist_yaw="0091"
                              tip="049"/>
    </xacro:if>

    <!-- 420093: Si 093 -->
    <xacro:if value="${str(instrument) == '420093'}">
      <xacro:instrument_model prefix="${prefix}"
                              housing="Si"
                              roll="4670"
                              wrist_pitch="0107"
                              wrist_yaw="0107"
                              tip="093"/>
    </xacro:if>

    <!-- 420172: Si 172 -->
    <xacro:if value="${str(instrument) == '420172'}">
      <xacro:instrument_model prefix="${prefix}"
                              housing="Si"
                              roll="4670"
                              wrist_pitch="0107"
                              wrist_yaw="0107"
