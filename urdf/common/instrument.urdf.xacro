    <!-- 420007: Si 007 -->
    <xacro:if value="${str(instrument) == '420007'}">
      <xacro:instrument_model prefix="${prefix}"
                              housing="Si"
                              roll="4670"
                              wrist_pitch="0091"
                              wrist_yaw="0091"
                              tip="007"/>
    </xacro:if>

    <!-- 420033: Si 033 -->
    <xacro:if value="${str(instrument) == '420033'}">
      <xacro:instrument_model prefix="${prefix}"
                              housing="Si"
                              roll="4670"
                              wrist_pitch="0091"
                              wrist_yaw="0091"
                              tip="033"/>
