<?xml version="1.0" encoding="utf-8"?>
<robot name="dvrk_instrument" xmlns:xacro="http://www.ros.org/wiki/xacro">

  <!--
    Instrument macro — generation-agnostic.

    Attaches to ${prefix}adaptor_link from the PSM base.

    Instruments are assembled from four physical stages:
      1. housing
      2. roll
      3. wrist_pitch + wrist_yaw
      4. tip

    Parameters:
      prefix        — arm instance prefix, e.g. "PSM1_"
      instrument    — last 6 digits of instrument model number (e.g. "420006")
      is_virtual    — omit the instrument housing visual/collision for virtual PSMs
  -->

  <xacro:include filename="$(find dvrk_model)/urdf/common.urdf.xacro"/>
  <xacro:property name="instrument_table"
                  value="${xacro.load_yaml('$(find dvrk_model)/urdf/common/instruments/instruments.yaml')['instruments']}"/>

  <!-- Opt-in URDF colors for the mesh-only virtual PSM instruments. -->
  <xacro:property name="roll_color" value="0.1 0.1 0.1 1"/>
  <xacro:property name="pitch_color" value="0.6 0.6 0.6 1"/>
  <xacro:property name="yaw_color" value="0.5 0.5 0.5 1"/>
  <xacro:property name="tip_color" value="0.4 0.4 0.4 1"/>

  <xacro:macro name="instrument_link_color" params="add_colors kind">
    <xacro:if value="${str(add_colors).lower() in ['true', '1']}">
      <xacro:if value="${kind == 'roll'}">
        <material name="roll_color"><color rgba="${roll_color}"/></material>
      </xacro:if>
      <xacro:if value="${kind == 'pitch'}">
        <material name="pitch_color"><color rgba="${pitch_color}"/></material>
      </xacro:if>
      <xacro:if value="${kind == 'yaw'}">
        <material name="yaw_color"><color rgba="${yaw_color}"/></material>
      </xacro:if>
      <xacro:if value="${kind == 'tip'}">
        <material name="tip_color"><color rgba="${tip_color}"/></material>
      </xacro:if>
    </xacro:if>
  </xacro:macro>

  <xacro:macro name="instrument_stage" params="part code prefix add_colors:=false">
    <!-- Xacro converts numeric arguments to integers; restore leading zeros. -->
    <xacro:property name="part_name" value="${part + '_' + (str(code) if str(code) == 'placeholder' else str(code).zfill(3 if part == 'tip' else 4))}"/>
    <xacro:include filename="$(find dvrk_model)/urdf/common/instruments/${part}/${part_name}.urdf.xacro"/>
    <xacro:call macro="${part_name}" prefix="${prefix}" add_colors="${add_colors}"/>
  </xacro:macro>

  <xacro:macro name="instrument_model"
               params="prefix housing roll tip wrist_pitch:=none wrist_yaw:=none wrist:=standard is_virtual:=false add_colors:=false">
    <!-- Part files and macro names follow the IDs in instruments.yaml.
         Missing geometry must be mapped explicitly to tip: placeholder. -->
    <xacro:if value="${str(is_virtual).lower() not in ['true', '1']}">
      <xacro:include filename="$(find dvrk_model)/urdf/common/instruments/housing/housing_${housing}.urdf.xacro"/>
      <xacro:call macro="${'housing_' + str(housing)}" prefix="${prefix}"/>
    </xacro:if>

    <xacro:instrument_stage part="roll" code="${roll}" prefix="${prefix}" add_colors="${add_colors}"/>
    <xacro:if value="${str(wrist) == 'standard'}">
      <xacro:instrument_stage part="wrist_pitch" code="${wrist_pitch}" prefix="${prefix}" add_colors="${add_colors}"/>
      <xacro:instrument_stage part="wrist_yaw" code="${wrist_yaw}" prefix="${prefix}" add_colors="${add_colors}"/>
    </xacro:if>
    <xacro:unless value="${str(wrist) == 'standard'}">
      <xacro:instrument_stage part="wrist" code="${wrist}" prefix="${prefix}" add_colors="${add_colors}"/>
    </xacro:unless>
    <xacro:instrument_stage part="tip" code="${tip}" prefix="${prefix}" add_colors="${add_colors}"/>
  </xacro:macro>

  <xacro:macro name="instrument"
               params="prefix instrument is_virtual:=false add_colors:=false">
    <xacro:property name="model" value="${instrument_table[str(instrument)]}"/>
    <xacro:if value="${xacro.message('Using instrument ' + str(instrument) + ': ' + str(model['name'])) or False}"/>
    <xacro:instrument_model prefix="${prefix}"
                            housing="${model['housing']}"
                            roll="${model['roll']}"
                            wrist_pitch="${model.get('wrist_pitch', 'none')}"
                            wrist_yaw="${model.get('wrist_yaw', 'none')}"
                            wrist="${model.get('wrist', 'standard')}"
                            tip="${model['tip']}"
                            is_virtual="${is_virtual}"
                            add_colors="${add_colors}"/>

  </xacro:macro>

</robot>
