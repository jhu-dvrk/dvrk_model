                              tip="296"/>
    </xacro:if>

    <!-- 420001: Si 001 -->
    <xacro:if value="${str(instrument) == '420001'}">
      <xacro:instrument_model prefix="${prefix}"
                              housing="Si"
                              roll="4670"
                              wrist_pitch="0091"
                              wrist_yaw="0091"
                              tip="001"/>
    </xacro:if>

    <!-- 420006: Si 006 -->
    <xacro:if value="${str(instrument) == '420006'}">
      <xacro:instrument_model prefix="${prefix}"
                              housing="Si"
                              roll="4670"
                              wrist_pitch="0091"
                              wrist_yaw="0091"
                              tip="006"/>
