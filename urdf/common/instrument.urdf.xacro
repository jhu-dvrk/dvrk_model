                              housing="Classic"
                              roll="4162"
                              wrist_pitch="0107"
                              wrist_yaw="0107"
                              tip="189"/>
    </xacro:if>

    <!-- 400205: Classic 205 -->
    <xacro:if value="${str(instrument) == '400205'}">
      <xacro:instrument_model prefix="${prefix}"
                              housing="Classic"
                              roll="4162"
                              wrist_pitch="0107"
                              wrist_yaw="0107"
                              tip="205"/>
    </xacro:if>

    <!-- 400207: Classic 207 -->
    <xacro:if value="${str(instrument) == '400207'}">
      <xacro:instrument_model prefix="${prefix}"
                              housing="Classic"
                              roll="4162"
                              wrist_pitch="0107"
                              wrist_yaw="0107"
                              tip="207"/>
    </xacro:if>

    <!-- 400208: Classic 208 -->
    <xacro:if value="${str(instrument) == '400208'}">
      <xacro:instrument_model prefix="${prefix}"
                              housing="Classic"
                              roll="4162"
                              wrist_pitch="0107"
                              wrist_yaw="0107"
                              tip="208"/>
    </xacro:if>

    <!-- 400230: Classic 230 -->
    <xacro:if value="${str(instrument) == '400230'}">
      <xacro:instrument_model prefix="${prefix}"
