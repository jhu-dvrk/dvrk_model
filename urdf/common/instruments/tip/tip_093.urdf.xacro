<?xml version="1.0" encoding="utf-8"?>
<robot name="dvrk_instrument_tip_093" xmlns:xacro="http://www.ros.org/wiki/xacro">

  <xacro:include filename="$(find dvrk_model)/urdf/common.urdf.xacro"/>

  <xacro:macro name="tip_093" params="prefix">
    <!--
      The ProGrasp jaw hinge is offset from wrist_yaw and this offset changes
      as the jaw opens.  URDF mimic joints are affine, so approximate the
      measured 7.7 mm (closed) to 5.5 mm (60 degree open) relationship with
      a prismatic joint along the wrist-yaw Y axis:

        distance = 0.0077 - (0.0022 / 1.0472) * jaw

      Keep jaw as the single actuated joint; jaw_axis, jaw_1 and jaw_2 are
      dependent joints.
    -->
    <joint name="jaw_axis" type="prismatic">
      <parent link="${prefix}wrist_yaw_link"/>
      <child link="${prefix}jaw_axis_link"/>
      <axis xyz="0.0 1.0 0.0"/>
      <origin rpy="0.0 0.0 0.0" xyz="0.0 0.0 0.0"/>
      <limit lower="0.0055" upper="0.0077" velocity="0.001" effort="1000"/>
      <mimic joint="jaw" multiplier="-0.002100845" offset="0.0077"/>
    </joint>

    <link name="${prefix}jaw_axis_link"/>

    <joint name="jaw" type="revolute">
      <parent link="${prefix}jaw_axis_link"/>
      <child link="${prefix}jaw_link"/>
      <axis xyz="1.0 0.0 0.0"/>
      <origin rpy="0.0 0.0 0.0" xyz="0.0 0.0 0.0"/>
      <limit lower="0.0" upper="1.0472" velocity=".4" effort="1000"/>
    </joint>

    <link name="${prefix}jaw_link">
      <visual>
        <origin rpy="0.0 0.0 0.0" xyz="0.0 0.0 0.0"/>
        <geometry><box size="0 0 0"/></geometry>
      </visual>
    </link>

  <joint name="jaw_1" type="revolute">
    <!-- Keep the tip hinge axes independent of the jaw-link rotation. -->
    <parent link="${prefix}jaw_axis_link"/>
    <child link="${prefix}jaw_1_link"/>
    <axis xyz="0.0 0.0 -1.0"/>
    <origin xyz="0 0 0" rpy="0 0 0"/>
    <limit lower="-1.5707" upper="1.5707" velocity=".4" effort="1000"/>
    <mimic joint="jaw" multiplier="0.5"/>
  </joint>

  <link name="${prefix}jaw_1_link">
    <visual>
      <origin 
        xyz="0.0 0.021 0.0" rpy="0 0 ${PI}"/>
      <geometry>
        <mesh
          filename="package://dvrk_model/meshes/instruments/tip/093/tip_093_1.obj"
          scale="0.001 0.001 0.001"/>
      </geometry>
    </visual>
  </link>


  <joint name="jaw_2" type="revolute">
    <parent link="${prefix}jaw_axis_link"/>
    <child link="${prefix}jaw_2_link"/>
    <axis xyz="0.0 0.0 -1.0"/>
    <origin xyz="0 0 0" rpy="0 0 0"/>
    <limit lower="-1.5707" upper="1.5707" velocity=".4" effort="1000"/>
    <mimic joint="jaw" multiplier="-0.5"/>
  </joint>

  <link name="${prefix}jaw_2_link">
    <visual>
      <origin 
        xyz="0.0 0.021 0.0" rpy="0 0 ${PI}"/>
      <geometry>
        <mesh
          filename="package://dvrk_model/meshes/instruments/tip/093/tip_093_2.obj"
          scale="0.001 0.001 0.001"/>
      </geometry>
    </visual>
  </link>

    <joint name="tool_tip" type="fixed">
      <parent link="${prefix}wrist_yaw_link"/>
      <child link="${prefix}tool_tip_link"/>
      <origin rpy="0.0 ${PI_2} ${PI_2}" xyz="0.0 0.0286 0.0"/>
    </joint>
    <link name="${prefix}tool_tip_link"/>
  </xacro:macro>

</robot>
