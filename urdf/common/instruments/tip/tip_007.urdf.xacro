<?xml version="1.0" encoding="utf-8"?>
<robot name="dvrk_instrument_tip_007" xmlns:xacro="http://www.ros.org/wiki/xacro">

  <xacro:include filename="$(find dvrk_model)/urdf/common.urdf.xacro"/>

  <!-- Round Tip Scissors: source meshes are in meters in the wrist-yaw frame.
       Jaw limits follow ROUND_TIP_SCISSORS_400007/420007.json.
       The tool-tip frame follows the tool JSON control-frame convention. -->
  <xacro:macro name="tip_007" params="prefix add_colors:=false">
    <joint name="jaw" type="revolute">
      <parent link="${prefix}wrist_yaw_link"/>
      <child link="${prefix}jaw_link"/>
      <axis xyz="0.0 0.0 1"/>
      <origin rpy="0.0 0.0 0.0" xyz="0.0 0.0 0.0"/>
      <limit lower="-0.698132" upper="0.698132" velocity=".4" effort="1000"/>
    </joint>

    <link name="${prefix}jaw_link"/>

    <joint name="jaw_1" type="revolute">
      <parent link="${prefix}wrist_yaw_link"/>
      <child link="${prefix}jaw_1_link"/>
      <axis xyz="0.0 0.0 1"/>
      <origin rpy="0.0 0.0 0.0" xyz="0.0 0 0.0"/>
      <limit lower="-1.5707" upper="1.5707" velocity=".4" effort="1000"/>
      <mimic joint="jaw" multiplier="0.5"/>
    </joint>

    <link name="${prefix}jaw_1_link">
      <visual>
        <origin rpy="0.0 0.0 0.0" xyz="0.0 0.0 0.0"/>
        <geometry>
          <mesh filename="package://dvrk_model/meshes/instruments/tip/007/tip_007_1.obj"/>
        </geometry>
      <xacro:instrument_link_color add_colors="${add_colors}" kind="tip"/>
      </visual>
    </link>

    <joint name="jaw_2" type="revolute">
      <parent link="${prefix}wrist_yaw_link"/>
      <child link="${prefix}jaw_2_link"/>
      <axis xyz="0.0 0.0 1"/>
      <origin rpy="0.0 0.0 0.0" xyz="0.0 0.0 0.0"/>
      <limit lower="-1.5707" upper="1.5707" velocity=".4" effort="1000"/>
      <mimic joint="jaw" multiplier="-0.5"/>
    </joint>

    <link name="${prefix}jaw_2_link">
      <visual>
        <origin rpy="0.0 0.0 0.0" xyz="0.0 0.0 0.0"/>
        <geometry>
          <mesh filename="package://dvrk_model/meshes/instruments/tip/007/tip_007_2.obj"/>
        </geometry>
      <xacro:instrument_link_color add_colors="${add_colors}" kind="tip"/>
      </visual>
    </link>

    <joint name="tool_tip" type="fixed">
      <parent link="${prefix}wrist_yaw_link"/>
      <child link="${prefix}tool_tip_link"/>
      <origin rpy="0.0 ${PI_2} ${PI_2}" xyz="0.0 0.0 0.0"/>
    </joint>
    <link name="${prefix}tool_tip_link"/>
  </xacro:macro>

</robot>
