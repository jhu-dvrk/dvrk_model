<?xml version="1.0" encoding="utf-8"?>
<robot name="dvrk_instrument_roll_4162" xmlns:xacro="http://www.ros.org/wiki/xacro">

  <xacro:include filename="$(find dvrk_model)/urdf/common.urdf.xacro"/>

  <xacro:macro name="roll_4162" params="prefix add_colors:=false">
    <joint name="roll" type="revolute">
      <parent link="${prefix}adaptor_link"/>
      <child link="${prefix}roll_link"/>
      <axis xyz="0.0 0.0 1"/>
      <origin rpy="0.0 0.0 0.0" xyz="0.0 0.0 0.4162"/>
      <limit lower="-4.53786" upper="4.53786" velocity=".4" effort="1000"/>
    </joint>

    <link name="${prefix}roll_link">
      <!-- Original Classic shaft dimensions from housing_Classic.dae.
           Keep the shaft on roll_link so virtual instruments retain it when
           the housing is hidden. The shaft starts 0.041 m from adaptor_link. -->
      <visual>
        <origin rpy="0.0 0.0 0.0" xyz="0.0 0.0 -0.1918"/>
        <geometry>
          <cylinder radius="0.0042" length="0.3668"/>
        </geometry>
        <xacro:if value="${str(add_colors).lower() not in ['true', '1']}">
          <material name="roll_4162_shaft"><color rgba="0.55 0.55 0.55 1"/></material>
        </xacro:if>
        <xacro:instrument_link_color add_colors="${add_colors}" kind="roll"/>
      </visual>
      <!-- Detailed wrist base includes the four pitch-axis pulleys. The
           shared geometry is exported in roll_link coordinates without the Si shaft. -->
      <visual>
        <origin rpy="0.0 0.0 0.0" xyz="0.0 0.0 0.0"/>
        <geometry>
          <mesh filename="package://dvrk_model/meshes/instruments/roll/4162/roll_4162_base.obj"/>
        </geometry>
        <xacro:instrument_link_color add_colors="${add_colors}" kind="roll"/>
      </visual>
      <collision>
        <!-- Envelope of the Classic shaft and detailed wrist base. -->
        <origin rpy="0.0 0.0 0.0" xyz="0.0 0.0 -0.1860837"/>
        <geometry>
          <cylinder radius="0.00421" length="0.3782326"/>
        </geometry>
      </collision>
    </link>
  </xacro:macro>

</robot>
