        <material name="wrist_yaw_frame_x">
          <color rgba="1.0 0.0 0.0 1.0"/>
        </material>
      </visual>
      <visual>
        <origin rpy="-${PI_2} 0.0 0.0" xyz="0.0 0.003 0.0"/>
        <geometry>
          <cylinder length="0.006" radius="0.00035"/>
        </geometry>
        <material name="wrist_yaw_frame_y">
          <color rgba="0.0 1.0 0.0 1.0"/>
