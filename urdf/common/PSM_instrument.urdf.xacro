<?xml version="1.0" encoding="utf-8"?>
<robot name="dvrk_psm_instrument" xmlns:xacro="http://www.ros.org/wiki/xacro">

  <!--
    PSM instrument macro — generation-agnostic.

    Attaches to ${parent_link} (= ${prefix}tool_parent_link from any
    PSM_base variant: Classic, Si, or Virtual).

    DOF layout:
      Joint 4: roll         (revolute, D = shaft_length along z)
      Joint 5: tip_pitch    (revolute)  ┐
      Joint 6: tip_yaw      (revolute)  ├── dispatched via PSM_tip_XXX macro
      Joint 7: jaw + mimics (revolute)  ┘

    Parameters:
      prefix        — arm instance prefix, e.g. "PSM1_"
      parent_link   — must be ${prefix}tool_parent_link
      shaft_length  — D parameter of roll joint (Classic: 0.4162, Si: 0.4670)
      instrument    — last 6 digits of instrument model number (e.g. "420006")
                      used to select the correct PSM_tip_XXX macro
  -->

  <xacro:include filename="$(find dvrk_model)/urdf/common.urdf.xacro"/>
  <xacro:include filename="$(find dvrk_model)/urdf/common/PSM_tips.urdf.xacro"/>

  <xacro:macro name="PSM_instrument"
               params="prefix parent_link instrument">
               
    <!-- Detect generation. ECM (SF0826001) uses Si-style mesh format. -->
    <xacro:property name="is_ecm" value="${str(instrument) == 'SF0826001'}"/>
    <xacro:property name="is_si"  value="${str(instrument).startswith('42') or is_ecm}"/>

    <!--
      Shaft length (D parameter of the roll joint):
        Classic PSM instruments → 0.4162
        Si PSM instruments      → 0.53559
        Si ECM (SF0826001)      → 0.4670   (camera tube is shorter than PSM shafts)
    -->
    <xacro:property name="shaft_length" value="${0.4670 if is_ecm else (0.53559 if is_si else 0.4162)}"/>
    <xacro:property name="tool_main_offset" value="${0.0 if is_si else 0.041}"/>
    <xacro:property name="roll_origin" value="${shaft_length + tool_main_offset}"/>

    <!-- fixed joint to hold the shaft visual BEFORE the roll joint -->
    <joint name="instrument_base_fixed" type="fixed">
      <parent link="${parent_link}"/>
      <child  link="${prefix}instrument_base_link"/>
      <origin rpy="0 0 0" xyz="0 0 0"/>
    </joint>

    <link name="${prefix}instrument_base_link">
      <visual>
        <xacro:if value="${is_si}">
          <origin rpy="0 0 0" xyz="-0.05591 0 ${roll_origin}"/>
          <geometry>
            <mesh filename="package://dvrk_model/meshes/instruments/Si/housing/PSM_housing.stl"/>
          </geometry>
        </xacro:if>
        <xacro:unless value="${is_si}">
          <origin rpy="0 0 1.5708" xyz="0 0 0.0904"/>
          <geometry>
            <mesh filename="package://dvrk_model/meshes/instruments/Classic/housing/PSM_housing.dae"/>
          </geometry>
        </xacro:unless>
      </visual>
      <collision>
        <xacro:if value="${is_si}">
          <origin rpy="0 0 0" xyz="-0.05591 0 ${roll_origin}"/>
          <geometry>
            <mesh filename="package://dvrk_model/meshes/instruments/Si/housing/PSM_housing.stl"/>
          </geometry>
        </xacro:if>
        <xacro:unless value="${is_si}">
          <origin rpy="0 0 1.5708" xyz="0 0 0.0904"/>
          <geometry>
            <mesh filename="package://dvrk_model/meshes/instruments/Classic/housing/PSM_housing.dae"/>
          </geometry>
        </xacro:unless>
      </collision>
    </link>

    <!-- joint 4: roll (outer roll of instrument inner shaft) -->
    <joint name="roll" type="revolute">
      <parent link="${parent_link}"/>
      <child  link="${prefix}roll_link"/>
      <axis xyz="0 0 1"/>
      <origin rpy="0 0 0" xyz="0 0 ${roll_origin}"/>
      <limit lower="-4.53786" upper="4.53786" velocity=".4" effort="1000"/>
    </joint>

    <!--
      PSM_roll_link — carries the inner shaft rotation.
      The outer shaft mesh (above) does not roll or shift.
    -->
    <link name="${prefix}roll_link"/>

    <!-- fixed joint to roll housing -->
    <joint name="roll_fixed" type="fixed">
      <parent link="${prefix}roll_link"/>
      <child  link="${prefix}roll_housing_link"/>
      <origin rpy="0 0 0" xyz="0 0 0"/>
    </joint>

    <link name="${prefix}roll_housing_link">
      <visual>
        <xacro:if value="${is_si}">
          <!-- Si roll housing piece is centered at the roll joint -->
          <origin rpy="-${PI} 0 0" xyz="0.05591 0 0"/>
          <geometry>
            <mesh filename="package://dvrk_model/meshes/instruments/Si/roll/PSM_roll_8mm.stl"/>
          </geometry>
          <material name=""><color rgba="0.79216 0.81961 0.93333 1"/></material>
        </xacro:if>
        <xacro:unless value="${is_si}">
          <!-- Classic roll housing at the shaft end -->
          <origin rpy="0 0 1.5708" xyz="0 0 -0.0091"/>
          <geometry>
            <mesh filename="package://dvrk_model/meshes/instruments/Classic/roll/PSM_roll.dae"/>
          </geometry>
        </xacro:unless>
      </visual>
      <collision>
        <xacro:if value="${is_si}">
          <origin rpy="-${PI} 0 0" xyz="0.05591 0 0"/>
          <geometry>
            <mesh filename="package://dvrk_model/meshes/instruments/Si/roll/PSM_roll_8mm.stl"/>
          </geometry>
        </xacro:if>
        <xacro:unless value="${is_si}">
          <origin rpy="0 0 1.5708" xyz="0 0 -0.0091"/>
          <geometry>
            <mesh filename="package://dvrk_model/meshes/instruments/Classic/roll/PSM_roll.dae"/>
          </geometry>
        </xacro:unless>
      </collision>
    </link>

    <!-- fixed joint to shaft -->
    <joint name="shaft_fixed" type="fixed">
      <parent link="${prefix}roll_housing_link"/>
      <child  link="${prefix}shaft_link"/>
      <origin rpy="0 0 0" xyz="0 0 0"/>
    </joint>

    <link name="${prefix}shaft_link">
      <visual>
        <xacro:if value="${is_si}">
          <origin rpy="0 0 0" xyz="0 0 0"/>
          <geometry>
            <mesh filename="package://dvrk_model/meshes/instruments/Si/roll/PSM_roll_8mm.stl"/>
          </geometry>
          <material name=""><color rgba="0.79216 0.81961 0.93333 1"/></material>
        </xacro:if>
        <xacro:unless value="${is_si}">
          <origin rpy="${PI_2} 0 0" xyz="0 0.00401 0"/>
          <geometry>
            <mesh filename="package://dvrk_model/meshes/instruments/Classic/yaw/PSM_yaw.dae"/>
          </geometry>
        </xacro:unless>
      </visual>
      <collision>
        <xacro:if value="${is_si}">
          <origin rpy="0 0 0" xyz="0 0 0"/>
          <geometry>
            <mesh filename="package://dvrk_model/meshes/instruments/Si/roll/PSM_roll_8mm.stl"/>
          </geometry>
        </xacro:if>
        <xacro:unless value="${is_si}">
          <origin rpy="${PI_2} 0 0" xyz="0 0.00401 0"/>
          <geometry>
            <mesh filename="package://dvrk_model/meshes/instruments/Classic/yaw/PSM_yaw.dae"/>
          </geometry>
        </xacro:unless>
      </collision>
    </link>

    <!--
      Tip dispatch: select the correct tip+jaw macro by instrument.
      Convention: last 3 digits of the model number identify the tip family.
        006 → standard SCA wrist (most instruments, A=0.0091)
        049 → Cadiere jaw (same wrist, different jaw geometry)
        172 → Maryland wrist (A=0.0107)
        117 → snake tool (5 mm shaft, extra coupled joints)
        183 → cautery / no-jaw tools
    -->
    <!-- 006: standard SCA wrist -->
    <xacro:if value="${str(instrument) == '420006' or str(instrument) == '400006' or
                      str(instrument) == '420036' or str(instrument) == '400036' or
                      str(instrument) == '420093' or str(instrument) == '400093' or
                      str(instrument) == '420168' or str(instrument) == '400168'}">
      <xacro:PSM_tip_006 prefix="${prefix}"
                         parent_link="${prefix}shaft_link"/>
    </xacro:if>

    <!-- 049: Cadiere jaw -->
    <xacro:if value="${str(instrument) == '420049' or str(instrument) == '400049'}">
      <xacro:PSM_tip_049 prefix="${prefix}"
                         parent_link="${prefix}shaft_link"/>
    </xacro:if>

    <!-- 172: Maryland wrist — currently reuses PSM_tip_006 placeholder meshes (see note in PSM_tips.urdf.xacro) -->
    <xacro:if value="${str(instrument) == '420172' or str(instrument) == '400172'}">
      <xacro:PSM_tip_172 prefix="${prefix}"
                         parent_link="${prefix}shaft_link"/>
    </xacro:if>

    <!-- 117: snake tool — PSM_tip_117 is currently a kinematic stub only (no meshes, no jaw geometry, DOFs unconfirmed) -->
    <xacro:if value="${str(instrument) == '400117'}">
      <xacro:PSM_tip_117 prefix="${prefix}"
                         parent_link="${prefix}shaft_link"/>
    </xacro:if>

    <!-- ECM: Si camera tip -->
    <xacro:if value="${str(instrument) == 'SF0826001'}">
      <xacro:PSM_tip_ECM prefix="${prefix}"
                         parent_link="${prefix}shaft_link"/>
    </xacro:if>

    <!-- 183: cautery / no-jaw tools — PSM_tip_183 macro exists in PSM_tips.urdf.xacro but is not yet wired into this dispatch -->


  </xacro:macro>

</robot>
