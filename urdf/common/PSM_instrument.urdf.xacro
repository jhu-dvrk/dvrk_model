<?xml version="1.0" encoding="utf-8"?>
<robot name="dvrk_psm_instrument" xmlns:xacro="http://www.ros.org/wiki/xacro">

  <!--
    PSM instrument macro — generation-agnostic.

    Attaches to ${parent_link} (= ${prefix}tool_parent_link from any
    PSM_base variant: Classic, Si, or Virtual).

    DOF layout:
      Joint 4: roll         (revolute, D = shaft_length along z)
      Joint 5: wrist_pitch  (revolute)  ┐
      Joint 6: wrist_yaw    (revolute)  ├── dispatched via PSM_tip_XXX macro
      Joint 7: jaw + mimics (revolute)  ┘

    Parameters:
      prefix        — arm instance prefix, e.g. "PSM1_"
      parent_link   — must be ${prefix}tool_parent_link
      shaft_length  — D parameter of roll joint (Classic: 0.4162, Si: 0.4670)
      instrument    — last 6 digits of instrument model number (e.g. "420006")
                      used to select the correct PSM_tip_XXX macro
  -->

  <xacro:include filename="$(find dvrk_model)/urdf/common.urdf.xacro"/>
  <xacro:include filename="$(find dvrk_model)/urdf/common/psm_tools/PSM_body.urdf.xacro"/>
  <xacro:include filename="$(find dvrk_model)/urdf/common/psm_tools/PSM_006.urdf.xacro"/>
  <xacro:include filename="$(find dvrk_model)/urdf/common/psm_tools/PSM_049.urdf.xacro"/>

  <xacro:macro name="PSM_instrument"
               params="prefix parent_link instrument">
               
    <!-- Detect generation. Si instruments use Si-style mesh format. -->
    <xacro:property name="is_si"  value="${str(instrument).startswith('42')}"/>

    <!--
      Shaft length (D parameter of the roll joint):
        Classic PSM instruments → 0.4162
        Si instruments          → 0.4670
        Classic instruments     → 0.4162
    -->
    <xacro:property name="shaft_length" value="${0.4670 if is_si else 0.4162}"/>
    <xacro:property name="tool_main_offset" value="${0.0 if is_si else 0.041}"/>
    <xacro:property name="roll_origin" value="${shaft_length + tool_main_offset}"/>
    <xacro:property name="tip_parent_link" value="${prefix + ('roll_link' if is_si else 'shaft_link')}"/>

    <xacro:PSM_instrument_body prefix="${prefix}"
                   parent_link="${parent_link}"
                   is_si="${is_si}"
                   roll_origin="${roll_origin}"/>

    <!--
      Tip dispatch: select the correct tip+jaw macro by instrument.
      Convention: last 3 digits of the model number identify the tip family.
        006 → standard SCA wrist (A=0.0091)
        049 → Cadiere jaw (A=0.0091)
      Verified common dimensions:
        roll D  → 0.4162 Classic, 0.4670 Si
        006 tip → tool_tip at y=0.0102
    -->
    <!-- 006: standard SCA wrist -->
    <xacro:if value="${str(instrument) == '420006' or str(instrument) == '400006' or
                      str(instrument) == '420036' or str(instrument) == '400036' or
                      str(instrument) == '420093' or str(instrument) == '400093' or
                      str(instrument) == '420168' or str(instrument) == '400168'}">
      <xacro:PSM_tip_006 prefix="${prefix}"
                         parent_link="${tip_parent_link}"
                         is_si="${is_si}"/>
    </xacro:if>

    <!-- 049: Cadiere jaw -->
    <xacro:if value="${str(instrument) == '400049'}">
      <xacro:PSM_tip_049 prefix="${prefix}"
                         parent_link="${tip_parent_link}"/>
    </xacro:if>


  </xacro:macro>

</robot>
