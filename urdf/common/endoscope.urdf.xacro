<?xml version="1.0"?>
<robot name="dvrk_endoscope" xmlns:xacro="http://www.ros.org/wiki/xacro">
  <xacro:property name="endoscope" value="$(arg endoscope)"/>
  <xacro:property name="endoscope_catalog" value="${xacro.load_yaml('$(find dvrk_model)/urdf/common/endoscopes/endoscopes.yaml')}"/>
  <xacro:property name="endoscope_key" value="${endoscope_catalog['aliases'].get(str(endoscope), str(endoscope))}"/>
  <xacro:property name="endoscope_parameters" value="${endoscope_catalog['scopes'][endoscope_key]}"/>
  <xacro:include filename="$(find dvrk_model)/urdf/common/ecm_optical.urdf.xacro"/>
  <xacro:include filename="$(find dvrk_model)/urdf/common/endoscopes/${endoscope_parameters['body']}.urdf.xacro"/>
</robot>
