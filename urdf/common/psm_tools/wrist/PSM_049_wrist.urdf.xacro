<?xml version="1.0" encoding="utf-8"?>
<robot name="dvrk_psm_049_wrist" xmlns:xacro="http://www.ros.org/wiki/xacro">

  <xacro:macro name="PSM_wrist_049" params="prefix parent_link">
    <joint name="wrist_pitch" type="revolute">
      <parent link="${parent_link}"/>
      <child  link="${prefix}wrist_049_pitch_link"/>
      <axis xyz="0 0 1"/>
      <origin rpy="-${PI_2} -${PI_2} 0" xyz="0 0 0"/>
      <limit lower="-${PI_2}" upper="${PI_2}" velocity=".4" effort="1000"/>
    </joint>

    <link name="${prefix}wrist_049_pitch_link">
      <visual>
        <origin rpy="0 -${PI_2} 0" xyz="-0.0024 0 0"/>
        <geometry>
          <mesh filename="package://dvrk_model/meshes/instruments/Classic/pitch/PSM_049_pitch.stl"/>
        </geometry>
      </visual>
    </link>

    <joint name="wrist_yaw" type="revolute">
      <parent link="${prefix}wrist_049_pitch_link"/>
      <child  link="${prefix}wrist_049_yaw_link"/>
      <axis xyz="0 0 1"/>
      <origin rpy="0 -${PI_2} -${PI_2}" xyz="0.0091 0 0"/>
      <limit lower="-1.3963" upper="1.3963" velocity=".4" effort="1000"/>
    </joint>

    <link name="${prefix}wrist_049_yaw_link">
      <visual>
        <origin rpy="0 ${PI_2} 0" xyz="0 -0.0002 0"/>
        <geometry>
          <mesh filename="package://dvrk_model/meshes/instruments/Classic/yaw/PSM_049_yaw.stl"/>
        </geometry>
      </visual>
    </link>
  </xacro:macro>

</robot>